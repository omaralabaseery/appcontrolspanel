    {
      "name": "05 Push notifications - real FCM opt in",
      "item": [
        {
          "name": "Send selected users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{pushKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/notifications",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"{{userId}}\",\n    \"title\": \"test\",\n    \"message\": \"test\"\n  },\n  {\n    \"id\": \"{{userId2}}\",\n    \"title\": \"test 2\",\n    \"message\": \"test 2\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"allowWrites\") !== \"true\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "if(pm.response.code===200) pm.environment.set(\"notificationId\",pm.response.json().id); pm.test(\"Push requests returned\",()=>pm.expect(pm.response.json().requests).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same request key - no duplicate send",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{pushKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/notifications/requests",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"{{userId}}\",\n    \"title\": \"test\",\n    \"message\": \"test\"\n  },\n  {\n    \"id\": \"{{userId2}}\",\n    \"title\": \"test 2\",\n    \"message\": \"test 2\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"allowWrites\") !== \"true\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "if(pm.response.code===200) pm.environment.set(\"notificationId\",pm.response.json().id); pm.test(\"Push requests returned\",()=>pm.expect(pm.response.json().requests).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send ALL users - separate opt in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{broadcastKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/notifications",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": 0,\n    \"title\": \"test\",\n    \"message\": \"test\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"allowWrites\") !== \"true\") { pm.execution.skipRequest(); }",
                  "if (pm.environment.get(\"allowBroadcast\") !== \"true\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "if(pm.response.code===200) pm.environment.set(\"notificationId\",pm.response.json().id); pm.test(\"Push requests returned\",()=>pm.expect(pm.response.json().requests).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        }
      ]
