{
  "info": {
    "name": "AppControl - API tests",
    "description": "Run against Spring Boot, not GitHub Pages. Configure local environment tokens. Writes are skipped unless allowWrites=true. Broadcast additionally needs allowBroadcast=true. Run folders deliberately; cleanup removes marked demo data. Read notification detail requests require notificationId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Public",
      "item": [
        {
          "name": "Connection status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/connection",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Connection fields\",()=>{const d=pm.response.json();pm.expect(d).to.have.property(\"status\");pm.expect(d).to.have.property(\"projectId\");});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mobile configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mobile/config?platform=android&build=241&language=ar",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Policy result\",()=>pm.expect(pm.response.json()).to.have.property(\"allowAccess\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Active occasions",
          "request": {
            "method": "GET",
